---
import Base from "../layouts/Base.astro";
import { formspreeIds } from "../data/site";
import { letters } from "../data/letters";

const contactId = formspreeIds.contact.trim();
const joinId = formspreeIds.join.trim();
const contactConnected = contactId.length > 0;
const joinConnected = joinId.length > 0;
---

<Base
  descriptionEn="Copy a letter to a U.S. official or a Syrian government recipient, or contact and join Syrian Scholars for Peace and Prosperity."
  descriptionAr="انسخ رسالة إلى مسؤول أمريكي أو إلى جهة في الحكومة السورية، أو راسل الباحثين السوريين من أجل السلام والازدهار وانضم إليهم."
>
  <main id="case" class="cases-page act-page">
    <header class="cases-intro act-intro">
      <h1>
        <span class="en">Act</span>
        <span class="ar" lang="ar">بادر</span>
      </h1>
      <p class="prose">
        <span class="en">Copy a letter, or write to the coalition.</span>
        <span class="ar" lang="ar">انسخ رسالة، أو اكتب إلى الائتلاف.</span>
      </p>
    </header>

    <div class="act-board">
      <div
        class="choices act-jobs"
        role="tablist"
        aria-label="What to do"
        data-label-en="What to do"
        data-label-ar="ماذا تفعل"
      >
        <button class="choice" type="button" role="tab" id="tab-write" aria-controls="write" aria-selected="true">
          <span class="en">Write an official</span>
          <span class="ar" lang="ar">اكتب إلى مسؤول</span>
        </button>
        <button class="choice" type="button" role="tab" id="tab-contact" aria-controls="contact" aria-selected="false" tabindex="-1">
          <span class="en">Contact</span>
          <span class="ar" lang="ar">راسل</span>
        </button>
        <button class="choice" type="button" role="tab" id="tab-join" aria-controls="join" aria-selected="false" tabindex="-1">
          <span class="en">Join</span>
          <span class="ar" lang="ar">انضم</span>
        </button>
      </div>

      <div class="act-stage">
    <section id="write" class="act-pane act-write is-current" role="tabpanel" aria-labelledby="tab-write">
      <svg class="trace" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <rect class="trace-base" x="1" y="1" width="98" height="98" pathLength="100"></rect>
        <rect class="trace-run" x="1" y="1" width="98" height="98" pathLength="100"></rect>
      </svg>
      <h2>
        <span class="en">Write an official</span>
        <span class="ar" lang="ar">اكتب إلى مسؤول</span>
      </h2>
      <p class="prose">
        <span class="en">Choose who is writing, and who receives the letter. Then copy it.</span>
        <span class="ar" lang="ar">اختر من يكتب، ومن يتلقى الرسالة. ثم انسخها.</span>
      </p>
      <div
        class="choices"
        role="group"
        aria-label="Who is writing"
        data-label-en="Who is writing"
        data-label-ar="من يكتب"
      >
        <button class="choice" type="button" data-writer="supporter" aria-pressed="true">
          <span class="en">Supporter</span>
          <span class="ar" lang="ar">داعم</span>
        </button>
        <button class="choice" type="button" data-writer="affected" aria-pressed="false">
          <span class="en">Affected person</span>
          <span class="ar" lang="ar">شخص متأثر</span>
        </button>
      </div>
      <div
        class="choices"
        role="group"
        aria-label="Who receives it"
        data-label-en="Who receives it"
        data-label-ar="من يتلقاها"
      >
        <button class="choice" type="button" data-recipient="us" aria-pressed="true">
          <span class="en">U.S. official</span>
          <span class="ar" lang="ar">مسؤول أمريكي</span>
        </button>
        <button class="choice" type="button" data-recipient="sy" aria-pressed="false">
          <span class="en">Syrian government</span>
          <span class="ar" lang="ar">الحكومة السورية</span>
        </button>
      </div>
      <div class="letter" id="letter" tabindex="0">{letters["supporter-us"].en}</div>
      <button class="action" type="button" id="copy-letter">
        <span class="en">Copy the letter</span>
        <span class="ar" lang="ar">انسخ الرسالة</span>
      </button>
      <p class="form-status" id="copy-status" aria-live="polite"></p>
    </section>

    <section id="contact" class="act-pane" role="tabpanel" aria-labelledby="tab-contact" hidden>
      <svg class="trace" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <rect class="trace-base" x="1" y="1" width="98" height="98" pathLength="100"></rect>
        <rect class="trace-run" x="1" y="1" width="98" height="98" pathLength="100"></rect>
      </svg>
      <h2>
        <span class="en">Contact</span>
        <span class="ar" lang="ar">راسل</span>
      </h2>
      <form class="sheet-form" data-kind="contact" novalidate>
        <input type="hidden" name="form" value="contact" />
        {
          !contactConnected && (
            <p class="form-note">
              <span class="en">Sending is not connected yet. Nothing you type here is sent.</span>
              <span class="ar" lang="ar">
                الإرسال غير موصول بعد. لن يُرسل ما كتبته.
              </span>
            </p>
          )
        }
        <label class="form-field">
          <span class="en">Name</span>
          <span class="ar" lang="ar">الاسم</span>
          <input name="name" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
          <p class="field-error" id="contact-name-error" hidden></p>
        </label>
        <label class="form-field">
          <span class="en">Email</span>
          <span class="ar" lang="ar">البريد الإلكتروني</span>
          <input name="email" type="email" autocomplete="email" required aria-describedby="contact-email-error" />
          <p class="field-error" id="contact-email-error" hidden></p>
        </label>
        <label class="form-field">
          <span class="en">Role</span>
          <span class="ar" lang="ar">الصفة</span>
          <select class="en" name="role" required aria-describedby="contact-role-error">
            <option value="supporter">Supporter</option>
            <option value="affected">Affected student or professional</option>
            <option value="press">Press</option>
            <option value="other">Other</option>
          </select>
          <select class="ar" name="role" lang="ar" required aria-describedby="contact-role-error">
            <option value="supporter">داعم</option>
            <option value="affected">طالب أو مهني متأثر</option>
            <option value="press">صحافة</option>
            <option value="other">غير ذلك</option>
          </select>
          <p class="field-error" id="contact-role-error" hidden></p>
        </label>
        <label class="form-field">
          <span class="en">Message</span>
          <span class="ar" lang="ar">الرسالة</span>
          <textarea name="message" rows="5" required aria-describedby="contact-message-error"></textarea>
          <p class="field-error" id="contact-message-error" hidden></p>
        </label>
        <p class="form-links">
          <a href="/privacy">
            <span class="en">Privacy</span>
            <span class="ar" lang="ar">الخصوصية</span>
          </a>
          <a href="/terms">
            <span class="en">Terms</span>
            <span class="ar" lang="ar">الشروط</span>
          </a>
        </p>
        <button class="action" type="submit">
          <span class="en">Send</span>
          <span class="ar" lang="ar">أرسل</span>
        </button>
        <p class="form-status" data-status aria-live="polite"></p>
      </form>
    </section>

    <section id="join" class="act-pane" role="tabpanel" aria-labelledby="tab-join" hidden>
      <svg class="trace" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <rect class="trace-base" x="1" y="1" width="98" height="98" pathLength="100"></rect>
        <rect class="trace-run" x="1" y="1" width="98" height="98" pathLength="100"></rect>
      </svg>
      <h2>
        <span class="en">Join</span>
        <span class="ar" lang="ar">انضم</span>
      </h2>
      <form class="sheet-form" data-kind="join" novalidate>
        <input type="hidden" name="form" value="join" />
        {
          !joinConnected && (
            <p class="form-note">
              <span class="en">Sending is not connected yet. Nothing you type here is sent.</span>
              <span class="ar" lang="ar">
                الإرسال غير موصول بعد. لن يُرسل ما كتبته.
              </span>
            </p>
          )
        }
        <label class="form-field">
          <span class="en">Name</span>
          <span class="ar" lang="ar">الاسم</span>
          <input name="name" type="text" autocomplete="name" required aria-describedby="join-name-error" />
          <p class="field-error" id="join-name-error" hidden></p>
        </label>
        <label class="form-field">
          <span class="en">Email</span>
          <span class="ar" lang="ar">البريد الإلكتروني</span>
          <input name="email" type="email" autocomplete="email" required aria-describedby="join-email-error" />
          <p class="field-error" id="join-email-error" hidden></p>
        </label>
        <label class="form-field">
          <span class="en">Country</span>
          <span class="ar" lang="ar">البلد</span>
          <input name="country" type="text" autocomplete="country-name" required aria-describedby="join-country-error" />
          <p class="field-error" id="join-country-error" hidden></p>
        </label>
        <label class="form-field">
          <span class="en">How you can help</span>
          <span class="ar" lang="ar">كيف يمكنك المساعدة</span>
          <textarea name="help" rows="5" required aria-describedby="join-help-error"></textarea>
          <p class="field-error" id="join-help-error" hidden></p>
        </label>
        <p class="form-links">
          <a href="/privacy">
            <span class="en">Privacy</span>
            <span class="ar" lang="ar">الخصوصية</span>
          </a>
          <a href="/terms">
            <span class="en">Terms</span>
            <span class="ar" lang="ar">الشروط</span>
          </a>
        </p>
        <button class="action" type="submit">
          <span class="en">Send</span>
          <span class="ar" lang="ar">أرسل</span>
        </button>
        <p class="form-status" data-status aria-live="polite"></p>
      </form>
    </section>
      </div>
    </div>
  </main>
  <script is:inline data-astro-rerun define:vars={{ letters, formspreeIds }}>
    (function () {
      if (window.__sspActStop) window.__sspActStop();
      var actObservers = [];
        window.__sspActStop = function () {
        actObservers.forEach(function (observer) {
          observer.disconnect();
        });
        window.clearTimeout(slideTimer);
        window.__sspActStop = null;
      };
      if (!window.__sspActHook) {
        window.__sspActHook = true;
        document.addEventListener("astro:before-swap", function () {
          if (window.__sspActStop) window.__sspActStop();
        });
      }
      var jobs = ["write", "contact", "join"];
      var jobName = "write";
      var writer = "supporter";
      var recipient = "us";
      var letter = document.getElementById("letter");
      var copyStatus = document.getElementById("copy-status");

      var slideTimer = 0;

      function paneShift(slot, index, rtl) {
        var delta = slot - index;
        if (rtl) delta = -delta;
        return "translate3d(" + delta * 100 + "%, 0, 0)";
      }

      function placePanes(name, instant) {
        var stage = document.querySelector(".act-stage");
        if (!stage) return;
        var index = jobs.indexOf(name);
        if (index < 0) index = 0;
        var rtl = document.documentElement.dir === "rtl";
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var snap = !!instant || reduce;
        var current = document.getElementById(name);
        var previous = document.querySelector(".act-pane.is-current");
        var from = previous ? jobs.indexOf(previous.id) : index;
        if (from < 0) from = index;
        jobs.forEach(function (job) {
          var pane = document.getElementById(job);
          if (!pane) return;
          if (job === name || (previous && job === previous.id)) pane.removeAttribute("hidden");
        });
        stage.classList.add("is-instant");
        jobs.forEach(function (job) {
          var pane = document.getElementById(job);
          if (!pane || pane.hidden) return;
          pane.style.transform = paneShift(jobs.indexOf(job), snap ? index : from, rtl);
        });
        if (current && !snap) current.classList.remove("is-current");
        void stage.offsetWidth;
        if (!snap) stage.classList.remove("is-instant");
        jobs.forEach(function (job) {
          var pane = document.getElementById(job);
          if (!pane || pane.hidden) return;
          var on = job === name;
          pane.style.transform = paneShift(jobs.indexOf(job), index, rtl);
          pane.classList.toggle("is-current", on);
          pane.inert = !on;
          if (on) pane.removeAttribute("aria-hidden");
          else pane.setAttribute("aria-hidden", "true");
          if (snap && !on) pane.setAttribute("hidden", "");
        });
        if (current) {
          current.inert = false;
          current.removeAttribute("aria-hidden");
          stage.style.height = current.offsetHeight + "px";
        }
        if (snap) {
          void stage.offsetWidth;
          stage.classList.remove("is-instant");
          return;
        }
        window.clearTimeout(slideTimer);
        slideTimer = window.setTimeout(function () {
          if (jobName !== name) return;
          jobs.forEach(function (job) {
            if (job === name) return;
            var pane = document.getElementById(job);
            if (!pane) return;
            pane.setAttribute("hidden", "");
          });
        }, 360);
      }

      function jobFromHash() {
        var hash = location.hash.replace("#", "");
        return jobs.indexOf(hash) >= 0 ? hash : "write";
      }

      function showJob(name) {
        var board = document.querySelector(".act-board");
        var first = !board || !board.classList.contains("act-ready");
        if (jobs.indexOf(name) < 0) name = "write";
        var changed = name !== jobName;
        jobName = name;
        placePanes(name, first || !changed);
        if (board) board.classList.add("act-ready");
        jobs.forEach(function (job) {
          var tab = document.getElementById("tab-" + job);
          if (!tab) return;
          var on = job === name;
          tab.setAttribute("aria-selected", on ? "true" : "false");
          tab.tabIndex = on ? 0 : -1;
        });
      }

      function holdScroll(run) {
        var x = window.scrollX;
        var y = window.scrollY;
        run();
        if (window.scrollX !== x || window.scrollY !== y) window.scrollTo(x, y);
      }

      var lockingStage = false;

      function lockStage() {
        if (lockingStage) return;
        var stage = document.querySelector(".act-stage");
        if (!stage || !document.querySelector(".act-board.act-ready")) return;
        lockingStage = true;
        var max = 0;
        jobs.forEach(function (job) {
          var pane = document.getElementById(job);
          if (!pane) return;
          var wasHidden = pane.hidden;
          if (wasHidden) {
            pane.removeAttribute("hidden");
            pane.style.visibility = "hidden";
          }
          max = Math.max(max, pane.offsetHeight);
          if (wasHidden) {
            pane.setAttribute("hidden", "");
            pane.style.visibility = "";
          }
        });
        if (max) stage.style.minHeight = max + "px";
        lockingStage = false;
      }

      function openJob(name, updateHash) {
        if (jobs.indexOf(name) < 0) name = "write";
        holdScroll(function () {
          showJob(name);
          lockStage();
          if (updateHash && location.hash !== "#" + name) {
            var next = location.pathname + location.search + "#" + name;
            history.replaceState(history.state, "", next);
          }
        });
      }

      document.querySelectorAll(".act-jobs [role='tab']").forEach(function (tab) {
        tab.addEventListener("mousedown", function (event) {
          event.preventDefault();
        });
        tab.addEventListener("click", function () {
          tab.focus({ preventScroll: true });
          openJob(tab.getAttribute("aria-controls") || "write", true);
        });
      });

      var jobList = document.querySelector(".act-jobs");
      if (jobList) {
        jobList.addEventListener("keydown", function (event) {
          var tabs = Array.prototype.slice.call(jobList.querySelectorAll("[role='tab']"));
          var index = tabs.indexOf(document.activeElement);
          if (index < 0) return;
          var step = document.documentElement.dir === "rtl" ? -1 : 1;
          var next = index;
          if (event.key === "ArrowRight") next = index + step;
          else if (event.key === "ArrowLeft") next = index - step;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          next = (next + tabs.length) % tabs.length;
          tabs[next].focus({ preventScroll: true });
          tabs[next].click();
        });
      }

      if (!window.__sspActHash) {
        window.__sspActHash = true;
        window.addEventListener("hashchange", function () {
          if (!document.getElementById("tab-write")) return;
          holdScroll(function () {
            showJob(jobFromHash());
            lockStage();
          });
        });
        document.addEventListener(
          "click",
          function (event) {
            var target = event.target;
            if (!(target instanceof Element)) return;
            var link = target.closest("a");
            if (!link || !link.href) return;
            var here = location.pathname.replace(/\/$/, "") || "/";
            if (here !== "/act") return;
            var url;
            try {
              url = new URL(link.href, location.href);
            } catch (e) {
              return;
            }
            var path = url.pathname.replace(/\/$/, "") || "/";
            var hash = url.hash.replace("#", "");
            if (url.origin !== location.origin || path !== "/act" || jobs.indexOf(hash) < 0) return;
            event.preventDefault();
            event.stopPropagation();
            openJob(hash, true);
          },
          true,
        );
      }

      openJob(jobFromHash(), false);
      lockStage();

      function lang() {
        return document.documentElement.lang === "ar" ? "ar" : "en";
      }

      function text(en, ar) {
        return lang() === "ar" ? ar : en;
      }

      function say(node, en, ar, tone) {
        if (!node) return;
        if (!en) {
          node.removeAttribute("data-en");
          node.removeAttribute("data-ar");
          node.removeAttribute("data-tone");
          node.textContent = "";
          return;
        }
        node.setAttribute("data-en", en);
        node.setAttribute("data-ar", ar);
        if (tone) node.setAttribute("data-tone", tone);
        else node.removeAttribute("data-tone");
        node.textContent = text(en, ar);
      }

      function paintStatus() {
        document.querySelectorAll("#copy-status, [data-status], .field-error").forEach(function (node) {
          var en = node.getAttribute("data-en");
          var ar = node.getAttribute("data-ar");
          if (en) node.textContent = text(en, ar || en);
        });
      }

      function markError(error, control, en, ar) {
        if (error) {
          error.hidden = false;
          say(error, en, ar);
        }
        if (control) control.setAttribute("aria-invalid", "true");
      }

      function clearError(field) {
        var error = field.querySelector(".field-error");
        if (error) {
          error.hidden = true;
          say(error, "", "");
        }
        field.querySelectorAll("[aria-invalid]").forEach(function (control) {
          control.removeAttribute("aria-invalid");
        });
      }

      function visibleControl(field) {
        return Array.prototype.find.call(field.querySelectorAll("input, textarea, select"), function (control) {
          return getComputedStyle(control).display !== "none" && !control.disabled;
        });
      }

      function emailOk(value) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);
      }

      function problemsFor(form) {
        var problems = [];
        form.querySelectorAll(".form-field").forEach(function (field) {
          var control = visibleControl(field);
          var error = field.querySelector(".field-error");
          if (!control || !error) return;
          var value = (control.value || "").trim();
          var name = control.getAttribute("name");
          if (!value) {
            if (name === "email") problems.push([error, control, "Enter your email.", "أدخل البريد الإلكتروني."]);
            else if (name === "message") problems.push([error, control, "Enter a message.", "أدخل الرسالة."]);
            else if (name === "help") problems.push([error, control, "Say how you can help.", "اذكر كيف يمكنك المساعدة."]);
            else if (name === "country") problems.push([error, control, "Enter your country.", "أدخل البلد."]);
            else if (name === "role") problems.push([error, control, "Choose a role.", "اختر الصفة."]);
            else problems.push([error, control, "Enter your name.", "أدخل الاسم."]);
          } else if (name === "email" && !emailOk(value)) {
            problems.push([error, control, "Enter a real email.", "أدخل بريداً إلكترونياً صالحاً."]);
          }
        });
        return problems;
      }

      function renderLetter() {
        if (!letter) return;
        var key = writer + "-" + recipient;
        var pair = letters[key];
        letter.textContent = pair ? pair[lang()] : "";
        document.querySelectorAll("[data-writer]").forEach(function (button) {
          button.setAttribute("aria-pressed", button.getAttribute("data-writer") === writer ? "true" : "false");
        });
        document.querySelectorAll("[data-recipient]").forEach(function (button) {
          button.setAttribute("aria-pressed", button.getAttribute("data-recipient") === recipient ? "true" : "false");
        });
      }

      document.querySelectorAll("[data-writer]").forEach(function (button) {
        button.addEventListener("click", function () {
          writer = button.getAttribute("data-writer") || writer;
          say(copyStatus, "", "");
          renderLetter();
        });
      });
      document.querySelectorAll("[data-recipient]").forEach(function (button) {
        button.addEventListener("click", function () {
          recipient = button.getAttribute("data-recipient") || recipient;
          say(copyStatus, "", "");
          renderLetter();
        });
      });

      var copy = document.getElementById("copy-letter");
      if (copy) {
        copy.addEventListener("click", function () {
          var value = letter ? letter.textContent || "" : "";
          function done(ok) {
            if (!copyStatus) return;
            say(
              copyStatus,
              ok ? "The letter is copied." : "Copy failed. Select the letter and copy it.",
              ok ? "نُسخت الرسالة." : "تعذر النسخ. حدّد الرسالة وانسخها.",
            );
          }
          function selectLetter() {
            if (!letter) return;
            var range = document.createRange();
            range.selectNodeContents(letter);
            var selection = window.getSelection();
            if (!selection) return;
            selection.removeAllRanges();
            selection.addRange(range);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(
              function () { done(true); },
              function () {
                selectLetter();
                done(false);
              },
            );
          } else {
            selectLetter();
            done(false);
          }
        });
      }

      function syncSelects() {
        var arabic = lang() === "ar";
        document.querySelectorAll("select.en").forEach(function (select) {
          select.disabled = arabic;
          select.required = !arabic;
        });
        document.querySelectorAll("select.ar").forEach(function (select) {
          select.disabled = !arabic;
          select.required = arabic;
        });
        renderLetter();
        paintStatus();
        placePanes(jobName, true);
      }

      var ids = formspreeIds || {};
      document.querySelectorAll(".sheet-form").forEach(function (form) {
        var status = form.querySelector("[data-status]");
        form.addEventListener("input", function (event) {
          if (!event.isTrusted) return;
          if (form.getAttribute("data-sending") === "true") return;
          var field = event.target && event.target.closest ? event.target.closest(".form-field") : null;
          if (field) clearError(field);
          say(status, "", "");
        });
        form.addEventListener("submit", function (event) {
          event.preventDefault();
          var kind = form.getAttribute("data-kind") || "";
          var id = String(ids[kind] || "").trim();
          var button = form.querySelector("button[type='submit']");
          syncSelects();
          form.querySelectorAll(".form-field").forEach(clearError);
          var problems = problemsFor(form);
          if (problems.length) {
            problems.forEach(function (problem) {
              markError(problem[0], problem[1], problem[2], problem[3]);
            });
            if (problems[0][1]) problems[0][1].focus();
            return;
          }
          if (!id) {
            say(
              status,
              "Sending is not connected yet. Nothing you type here is sent.",
              "الإرسال غير موصول بعد. لن يُرسل ما كتبته.",
            );
            return;
          }
          say(status, "Sending.", "جارٍ الإرسال.");
          form.setAttribute("data-sending", "true");
          if (button) button.disabled = true;
          fetch("https://formspree.io/f/" + id, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form),
          })
            .then(function (response) {
              if (!response.ok) throw new Error("status");
              say(status, "Your message was received.", "وصلت رسالتك.", "ok");
              form.reset();
              syncSelects();
            })
            .catch(function () {
              say(
                status,
                "Sending failed. Nothing was confirmed. Try again.",
                "تعذر الإرسال. لم يُؤكَّد شيء. أعد المحاولة.",
                "error",
              );
            })
            .then(function () {
              form.removeAttribute("data-sending");
              if (button) button.disabled = false;
            });
        });
      });

      var langObserver = new MutationObserver(syncSelects);
      langObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["lang"],
      });
      actObservers.push(langObserver);
      var stageWatch = new ResizeObserver(function (entries) {
        var stage = document.querySelector(".act-stage");
        if (!stage) return;
        entries.forEach(function (entry) {
          if (entry.target.id !== jobName) return;
          var next = entry.target.offsetHeight + "px";
          if (stage.style.height !== next) stage.style.height = next;
          lockStage();
        });
      });
      jobs.forEach(function (job) {
        var pane = document.getElementById(job);
        if (pane) stageWatch.observe(pane);
      });
      actObservers.push(stageWatch);
      syncSelects();
    })();
  </script>
</Base>
