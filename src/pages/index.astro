---
import Base from "../layouts/Base.astro";
import Institution from "../components/Institution.astro";
import { cases } from "../data/cases";

const descriptionEn =
  "Syrian scholars admitted to U.S. institutions explain why Presidential Proclamation 10998 should exempt qualified Syrian nationals, and how to write, contact, or join.";
const descriptionAr =
  "يشرح باحثون سوريون مقبولون في مؤسسات أمريكية لماذا ينبغي إعفاء السوريين المؤهلين من الإعلان الرئاسي 10998، وكيف تكتب أو تراسل أو تنضم.";
---

<Base descriptionEn={descriptionEn} descriptionAr={descriptionAr}>
  <main id="case">
    <div class="first">
      <div class="field">
        <article class="parcel">
          <svg class="trace" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <rect class="trace-base" x="1" y="1" width="98" height="98" pathLength="100"></rect>
            <rect class="trace-run" x="1" y="1" width="98" height="98" pathLength="100"></rect>
          </svg>
          <div class="parcel-copy">
            <h1>
              <span class="en">Presidential Proclamation 10998 blocks our entry.</span>
              <span class="ar" lang="ar">الإعلان الرئاسي 10998 يمنع دخولنا.</span>
            </h1>
            <p class="prose">
              <span class="en">
                It categorically blocks the entry and visa issuance of Syrian nationals to the United States.
                We are students, doctors, engineers, and professionals already admitted to U.S. institutions,
                most of us on full scholarships, and our academic and professional futures are stalled.
              </span>
              <span class="ar" lang="ar">
                يمنع الإعلان، منعاً قاطعاً، دخول المواطنين السوريين إلى الولايات المتحدة وإصدار التأشيرات لهم.
                نحن طلاب وأطباء ومهندسون ومهنيون مقبولون أصلاً في مؤسسات أمريكية، وأكثرنا بمنح دراسية كاملة،
                ومستقبلنا الأكاديمي والمهني متوقف.
              </span>
            </p>
          </div>
        </article>
        <ol class="timeline">
          <li>
            <p>
              <span class="en"><time datetime="2024-12-08">8 December 2024</time> — fall of the former government</span>
              <span class="ar" lang="ar"><time datetime="2024-12-08">8 كانون الأول/ديسمبر 2024</time> — سقوط الحكومة السابقة</span>
            </p>
          </li>
          <li>
            <p>
              <span class="en"><time datetime="2025-06-30">30 June 2025</time> — U.S. sanctions terminated</span>
              <span class="ar" lang="ar"><time datetime="2025-06-30">30 حزيران/يونيو 2025</time> — أُنهيت العقوبات الأمريكية</span>
            </p>
          </li>
          <li>
            <p>
              <span class="en"><time datetime="2025-12-18">18 December 2025</time> — Caesar Act repealed</span>
              <span class="ar" lang="ar"><time datetime="2025-12-18">18 كانون الأول/ديسمبر 2025</time> — أُلغي قانون قيصر</span>
            </p>
          </li>
          <li class="mark">
            <p>
              <span class="en"><time datetime="2026-01-01">1 January 2026</time> — Presidential Proclamation 10998 blocks entry</span>
              <span class="ar" lang="ar"><time datetime="2026-01-01">1 كانون الثاني/يناير 2026</time> — الإعلان الرئاسي 10998 يمنع الدخول</span>
            </p>
          </li>
          <li>
            <p>
              <span class="en"><time datetime="2026-08-24">24 August 2026</time> — State Sponsor of Terrorism designation rescinded</span>
              <span class="ar" lang="ar"><time datetime="2026-08-24">24 آب/أغسطس 2026</time> — أُلغي تصنيف الدولة الراعية للإرهاب</span>
            </p>
          </li>
        </ol>
      </div>
    </div>

    <section class="tape" aria-labelledby="tape-title">
      <h2 id="tape-title">
        <span class="en">Admitted, and still waiting.</span>
        <span class="ar" lang="ar">مقبولون، وما زالوا ينتظرون.</span>
      </h2>
      <div class="cases-rail" data-cases>
        <div class="cases-track">
          <div class="cases-set">
            {
              cases.map((person) => (
                <a class="case-card" href={`/cases#${person.id}`}>
                  <div class="case-id">
                    <h3>
                      <span class="en">{person.nameEn}</span>
                      <span class="ar" lang="ar">
                        {person.nameAr}
                      </span>
                    </h3>
                    <p class="case-place">
                      <span class="en">{person.fieldEn}</span>
                      <span class="ar" lang="ar">
                        {person.fieldAr}
                      </span>
                    </p>
                    <Institution name={person.institution} />
                  </div>
                  <p class="case-line">
                    <span class="en">{person.sentenceEn}</span>
                    <span class="ar" lang="ar">
                      {person.sentenceAr}
                    </span>
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <div class="reading">
      <section id="change">
        <div class="circumstance">
          <div class="circumstance-copy">
            <h2>
              <span class="en">The circumstances that necessitated these restrictions no longer exist.</span>
              <span class="ar" lang="ar">لم تعد الظروف التي اقتضت هذه القيود قائمة.</span>
            </h2>
            <p class="prose">
              <span class="en">
                Syria is recovering. It no longer constitutes a security threat to anyone and is actively
                transitioning into a center for regional peace, development, and prosperity.
              </span>
              <span class="ar" lang="ar">
                سوريا تتعافى. لم تعد تشكل تهديداً أمنياً لأحد، وهي تنتقل بفاعلية لتصبح مركزاً للسلام والتنمية
                والازدهار في المنطقة.
              </span>
            </p>
          </div>
          <img
            class="plate en"
            src="/handshake.webp"
            width="1280"
            height="850"
            alt="The presidents of the United States and Syria."
            decoding="async"
          />
          <img
            class="plate ar"
            src="/handshake.webp"
            width="1280"
            height="850"
            lang="ar"
            alt="رئيسا الولايات المتحدة وسوريا."
            decoding="async"
          />
        </div>
        <div class="mission-row" id="mission">
          <img
            class="plate en"
            src="/flags.webp"
            width="1001"
            height="667"
            alt="The Syrian and U.S. flags."
            decoding="async"
          />
          <img
            class="plate ar"
            src="/flags.webp"
            width="1001"
            height="667"
            lang="ar"
            alt="علما سوريا والولايات المتحدة."
            decoding="async"
          />
          <p class="mission">
            <span class="en">We will study in the United States, then return to rebuild Syria.</span>
            <span class="ar" lang="ar">سندرس في الولايات المتحدة، ثم نعود لإعادة إعمار سوريا.</span>
          </p>
        </div>
      </section>
    </div>

    <section class="station" id="write" aria-label="Act" data-label-en="Act" data-label-ar="بادر">
      <a class="action" href="/act#write">
        <span class="en">Write an official</span>
        <span class="ar" lang="ar">اكتب إلى مسؤول</span>
      </a>
      <a class="action" href="/act#contact">
        <span class="en">Contact</span>
        <span class="ar" lang="ar">راسل</span>
      </a>
      <a class="action" href="/act#join">
        <span class="en">Join</span>
        <span class="ar" lang="ar">انضم</span>
      </a>
    </section>
  </main>
  <script is:inline data-astro-rerun>
    (function () {
      var rail = document.querySelector("[data-cases]");
      if (!rail) return;
      if (window.__sspTapeStop) window.__sspTapeStop();
      var tapeAbort = new AbortController();
      var tapeObservers = [];
      window.__sspTapeStop = function () {
        tapeAbort.abort();
        tapeObservers.forEach(function (observer) {
          observer.disconnect();
        });
        window.__sspTapeStop = null;
      };
      if (!window.__sspTapeHook) {
        window.__sspTapeHook = true;
        document.addEventListener("astro:before-swap", function () {
          if (window.__sspTapeStop) window.__sspTapeStop();
        });
      }
      function listen(target, type, fn, options) {
        var opts = options && typeof options === "object" ? Object.assign({}, options) : { capture: !!options };
        opts.signal = tapeAbort.signal;
        target.addEventListener(type, fn, opts);
      }
      var track = rail.querySelector(".cases-track");
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      var seen = true;
      var pointerInside = false;
      var focusInside = false;
      var dragging = false;
      var dragMoved = false;
      var startX = 0;
      var startScroll = 0;
      var scrollPerPx = -1;
      var wrapping = false;

      function clearClones() {
        track.querySelectorAll("[data-clone]").forEach(function (node) {
          node.remove();
        });
      }

      function durationSeconds() {
        var raw = getComputedStyle(rail).getPropertyValue("--cases-duration").trim() || "42s";
        var value = parseFloat(raw);
        if (!isFinite(value) || value <= 0) return 42;
        return /ms$/i.test(raw) ? value / 1000 : value;
      }

      function loopWidth() {
        if (track.querySelector("[data-clone]")) return track.getBoundingClientRect().width / 2;
        var set = track.querySelector(".cases-set");
        return set ? set.getBoundingClientRect().width : 0;
      }

      function marker() {
        return track.querySelector(".cases-set:not([data-clone]) .case-card");
      }

      function measurePerPx(card) {
        var origin = rail.scrollLeft;
        var before = card.getBoundingClientRect().left;
        rail.scrollLeft = origin + 12;
        var after = card.getBoundingClientRect().left;
        rail.scrollLeft = origin;
        var per = (after - before) / 12;
        return Math.abs(per) > 0.01 ? per : -1;
      }

      function keyboardFocusInside() {
        var active = document.activeElement;
        return !!(active && rail.contains(active) && active.closest && active.closest("a") && active.matches(":focus-visible"));
      }

      function held() {
        return pointerInside || focusInside || dragging;
      }

      function pointerInRail(event) {
        if (!event || typeof event.clientX !== "number") return pointerInside;
        var box = rail.getBoundingClientRect();
        return event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
      }

      function freeze() {
        if (reduce.matches || rail.classList.contains("is-paused") || !rail.classList.contains("is-live")) return;
        var card = marker();
        if (!card) return;
        var before = card.getBoundingClientRect().left;
        rail.classList.add("is-paused");
        track.style.animation = "none";
        track.style.transform = "none";
        void track.offsetWidth;
        var origin = rail.scrollLeft;
        rail.dataset.origin = String(origin);
        var after = card.getBoundingClientRect().left;
        var per = measurePerPx(card);
        scrollPerPx = per;
        rail.scrollLeft = origin + (before - after) / per;
      }

      function release() {
        if (!rail.classList.contains("is-paused") || held()) return;
        var card = marker();
        var width = loopWidth();
        var origin = Number(rail.dataset.origin || "0");
        var progress = 0;
        if (card && width > 1) {
          var atScroll = card.getBoundingClientRect().left;
          rail.scrollLeft = origin;
          var atOrigin = card.getBoundingClientRect().left;
          var traveled = document.documentElement.dir === "rtl" ? atScroll - atOrigin : atOrigin - atScroll;
          progress = traveled / width;
          progress = ((progress % 1) + 1) % 1;
        }
        track.style.removeProperty("animation");
        track.style.removeProperty("transform");
        track.style.setProperty("--cases-delay", -progress * durationSeconds() + "s");
        rail.classList.remove("is-paused");
      }

      function sync() {
        rail.classList.toggle("is-quiet", document.hidden || !seen);
        if (reduce.matches) {
          clearClones();
          rail.classList.remove("is-live", "is-paused");
          track.style.removeProperty("animation");
          track.style.removeProperty("transform");
          track.style.removeProperty("--cases-delay");
          return;
        }
        if (!track.querySelector("[data-clone]")) {
          var set = track.querySelector(".cases-set");
          if (!set) return;
          var clone = set.cloneNode(true);
          clone.setAttribute("data-clone", "");
          clone.setAttribute("aria-hidden", "true");
          clone.querySelectorAll("a").forEach(function (link) {
            link.tabIndex = -1;
          });
          track.appendChild(clone);
        }
        rail.classList.add("is-live");
        if (held()) freeze();
      }

      if ("IntersectionObserver" in window) {
        var seenObserver = new IntersectionObserver(
          function (entries) {
            seen = entries.some(function (entry) {
              return entry.isIntersecting;
            });
            sync();
          },
          { threshold: 0.2 },
        );
        seenObserver.observe(rail);
        tapeObservers.push(seenObserver);
      }

      listen(document, "visibilitychange", sync);
      if (typeof reduce.addEventListener === "function") listen(reduce, "change", sync);

      function syncHover(event) {
        pointerInside = pointerInRail(event);
        if (dragging && event.pointerType === "mouse") {
          var dx = event.clientX - startX;
          if (Math.abs(dx) > 6) dragMoved = true;
          rail.scrollLeft = startScroll + dx / scrollPerPx;
          return;
        }
        if (pointerInside) freeze();
        else if (!dragging) release();
      }

      listen(rail, "pointerenter", function () {
        pointerInside = true;
        freeze();
      });
      listen(rail, "pointerleave", function () {
        pointerInside = false;
        if (!dragging) release();
      });
      listen(document, "pointermove", syncHover);
      listen(rail, "focusin", function () {
        focusInside = keyboardFocusInside();
        if (focusInside) freeze();
      });
      listen(rail, "focusout", function () {
        requestAnimationFrame(function () {
          focusInside = keyboardFocusInside();
          if (!focusInside) release();
        });
      });

      listen(rail, "pointerdown", function (event) {
        if (event.pointerType !== "mouse" || event.button !== 0) {
          pointerInside = true;
          freeze();
          return;
        }
        if (!reduce.matches && !rail.classList.contains("is-paused")) freeze();
        if (!reduce.matches && !rail.classList.contains("is-paused")) return;
        var card = marker();
        if (card) scrollPerPx = measurePerPx(card);
        dragging = true;
        dragMoved = false;
        startX = event.clientX;
        startScroll = rail.scrollLeft;
        rail.classList.add("is-dragging");
      });
      function endDrag(event) {
        if (event && event.pointerType && event.pointerType !== "mouse") {
          pointerInside = false;
          focusInside = keyboardFocusInside();
          release();
          return;
        }
        if (!dragging) return;
        dragging = false;
        rail.classList.remove("is-dragging");
        pointerInside = pointerInRail(event);
        focusInside = keyboardFocusInside();
        if (dragMoved) {
          listen(
            rail,
            "click",
            function block(clickEvent) {
              clickEvent.preventDefault();
              clickEvent.stopPropagation();
              rail.removeEventListener("click", block, true);
            },
            true,
          );
        }
        release();
      }
      listen(document, "pointerup", endDrag);
      listen(document, "pointercancel", endDrag);
      listen(rail, "dragstart", function (event) {
        event.preventDefault();
      });
      listen(
        rail,
        "scroll",
        function () {
          if (wrapping || reduce.matches || !rail.classList.contains("is-paused")) return;
          var width = loopWidth();
          if (width < 8) return;
          var origin = Number(rail.dataset.origin || "0");
          var rel = rail.scrollLeft - origin;
          var wrapped = rel % width;
          if (wrapped < 0) wrapped += width;
          if (Math.abs(wrapped - rel) < 0.5) return;
          wrapping = true;
          rail.scrollLeft = origin + wrapped;
          wrapping = false;
        },
        { passive: true },
      );

      var dirObserver = new MutationObserver(function () {
        track.style.removeProperty("--cases-delay");
        if (!rail.classList.contains("is-paused")) return;
        rail.classList.remove("is-paused");
        track.style.removeProperty("animation");
        track.style.removeProperty("transform");
        rail.scrollLeft = 0;
        if (held()) freeze();
      });
      dirObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["dir"] });
      tapeObservers.push(dirObserver);

      sync();
    })();
  </script>
</Base>
