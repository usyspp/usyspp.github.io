---
import Base from "../layouts/Base.astro";
---

<Base
  descriptionEn="Updates from Syrian Scholars for Peace and Prosperity."
  descriptionAr="مستجدات الباحثين السوريين من أجل السلام والازدهار."
>
  <main id="case" class="sheet-note">
    <h1>
      <span class="en">Updates</span>
      <span class="ar" lang="ar">المستجدات</span>
    </h1>
    <p class="prose">
      <span class="en">The coalition will post updates on this sheet over time.</span>
      <span class="ar" lang="ar">سينشر الائتلاف المستجدات على هذه الورقة مع الوقت.</span>
    </p>
    <a class="return" href="/">
      <span class="en">Return to the case</span>
      <span class="ar" lang="ar">العودة إلى القضية</span>
    </a>
  </main>
</Base>
