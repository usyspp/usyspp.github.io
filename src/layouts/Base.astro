---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  descriptionEn: string;
  descriptionAr: string;
}

const { descriptionEn, descriptionAr } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", en: "Home", ar: "الرئيسية" },
  { href: "/updates", en: "Updates", ar: "المستجدات" },
  { href: "/cases", en: "Cases", ar: "الحالات" },
  { href: "/act", en: "Act", ar: "بادر" },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#002623" />
    <ClientRouter fallback="swap" />
    <script is:inline>
      (function () {
        var lang = "en";
        try {
          var query = new URLSearchParams(location.search).get("lang");
          var stored = localStorage.getItem("ssp-lang");
          if (query === "ar" || query === "en") lang = query;
          else if (stored === "ar" || stored === "en") lang = stored;
        } catch (e) {}
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
        var fonts = [
          "/fonts/readex-pro-latin-600-normal.woff2",
          "/fonts/readex-pro-latin-500-normal.woff2",
        ];
        if (lang === "ar") {
          fonts.push(
            "/fonts/noto-naskh-arabic-arabic-700-normal.woff2",
            "/fonts/noto-naskh-arabic-arabic-400-normal.woff2",
            "/fonts/noto-naskh-arabic-latin-700-normal.woff2",
            "/fonts/noto-naskh-arabic-latin-400-normal.woff2",
            "/fonts/readex-pro-arabic-600-normal.woff2",
            "/fonts/readex-pro-arabic-500-normal.woff2",
          );
        } else {
          fonts.push(
            "/fonts/petrona-latin-500-normal.woff2",
            "/fonts/petrona-latin-400-normal.woff2",
          );
        }
        for (var i = 0; i < fonts.length; i++) {
          var link = document.createElement("link");
          link.rel = "preload";
          link.as = "font";
          link.type = "font/woff2";
          link.crossOrigin = "anonymous";
          link.href = fonts[i];
          document.head.appendChild(link);
        }
      })();
    </script>
    <title
      id="doc-title"
      data-en="Syrian Scholars for Peace and Prosperity"
      data-ar="باحثون سوريون من أجل السلام والازدهار"
    >
      Syrian Scholars for Peace and Prosperity
    </title>
    <meta
      id="doc-desc"
      name="description"
      content={descriptionEn}
      data-en={descriptionEn}
      data-ar={descriptionAr}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "fd41a6738ba84e1ca0057f8aaebc3486"}'
      transition:persist="cf-beacon"
    ></script>
    <script is:inline>
      (function () {
        var lang = "en";
        try {
          var query = new URLSearchParams(location.search).get("lang");
          var stored = localStorage.getItem("ssp-lang");
          if (query === "ar" || query === "en") lang = query;
          else if (stored === "ar" || stored === "en") lang = stored;
        } catch (e) {}
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
        var title = document.getElementById("doc-title");
        if (title) title.textContent = title.getAttribute("data-" + lang) || title.textContent;
        var desc = document.getElementById("doc-desc");
        if (desc) desc.setAttribute("content", desc.getAttribute("data-" + lang) || "");
      })();
    </script>
  </head>
  <body>
    <a class="skip en" href="#case">Skip to the case</a>
    <a class="skip ar" lang="ar" href="#case">انتقل إلى القضية</a>
    <header class="titleblock" transition:persist="titleblock">
      <p class="masthead">
        <span class="en">Syrian Scholars for Peace and Prosperity</span>
        <span class="ar" lang="ar">باحثون سوريون من أجل السلام والازدهار</span>
      </p>
      <div class="title-bar">
      <nav class="nav" aria-label="Primary" data-label-en="Primary" data-label-ar="التنقل">
        {
          links.map((link) => (
            <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
              <span class="en">{link.en}</span>
              <span class="ar" lang="ar">
                {link.ar}
              </span>
            </a>
          ))
        }
      </nav>
      <div class="title-tools">
        <button class="lang-switch" type="button" id="lang-switch">
          <span class="en" lang="ar">العربية</span>
          <span class="ar">English</span>
        </button>
        <a class="action" href="/act#write">
          <span class="en">Write an official</span>
          <span class="ar" lang="ar">اكتب إلى مسؤول</span>
        </a>
      </div>
      </div>
    </header>
    <slot />
    <footer class="colophon" transition:persist="colophon">
      <p>
        <span class="en">Syrian Scholars for Peace and Prosperity</span>
        <span class="ar" lang="ar">باحثون سوريون من أجل السلام والازدهار</span>
      </p>
      <p class="colophon-links">
        <a href="/privacy">
          <span class="en">Privacy</span>
          <span class="ar" lang="ar">الخصوصية</span>
        </a>
        <a href="/terms">
          <span class="en">Terms</span>
          <span class="ar" lang="ar">الشروط</span>
        </a>
      </p>
    </footer>
    <p class="visually-hidden" id="lang-status" aria-live="polite"></p>
    <script is:inline>
      (function () {
        var lang = document.documentElement.lang === "ar" ? "ar" : "en";

        function apply(next, announce) {
          document.documentElement.lang = next;
          document.documentElement.dir = next === "ar" ? "rtl" : "ltr";
          try {
            localStorage.setItem("ssp-lang", next);
            var nextUrl = new URL(location.href);
            nextUrl.searchParams.set("lang", next);
            history.replaceState(null, "", nextUrl);
          } catch (e) {}
          var title = document.getElementById("doc-title");
          if (title) title.textContent = title.getAttribute("data-" + next) || title.textContent;
          var desc = document.getElementById("doc-desc");
          if (desc) desc.setAttribute("content", desc.getAttribute("data-" + next) || "");
          document.querySelectorAll("[data-label-en]").forEach(function (el) {
            var label = el.getAttribute("data-label-" + next);
            if (label) el.setAttribute("aria-label", label);
          });
          var path = location.pathname.replace(/\/$/, "") || "/";
          document.querySelectorAll(".nav a").forEach(function (link) {
            var href = link.getAttribute("href");
            if (href === path) link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
          });
          if (announce) {
            var status = document.getElementById("lang-status");
            if (status) status.textContent = next === "ar" ? "العربية" : "English";
          }
        }

        function warm(next) {
          if (!document.fonts || !document.fonts.load) return Promise.resolve();
          var jobs = [];
          if (next === "ar") {
            jobs.push(document.fonts.load('700 1em "Noto Naskh Arabic"', "العربية"));
            jobs.push(document.fonts.load('400 1em "Noto Naskh Arabic"', "العربية"));
            jobs.push(document.fonts.load('600 1em "Readex Pro"', "العربية"));
            jobs.push(document.fonts.load('500 1em "Readex Pro"', "العربية"));
          } else {
            jobs.push(document.fonts.load("500 1em Petrona", "Syrian"));
            jobs.push(document.fonts.load("400 1em Petrona", "Syrian"));
          }
          return Promise.race([
            Promise.all(jobs),
            new Promise(function (resolve) {
              setTimeout(resolve, 800);
            }),
          ]);
        }

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          if (!target.closest("#lang-switch")) return;
          var next = document.documentElement.lang === "ar" ? "en" : "ar";
          warm(next).then(function () {
            apply(next, true);
          });
        });

        var sheetOrder = ["/", "/updates", "/cases", "/act"];

        function sheetIndex(url) {
          var path = url.pathname.replace(/\/$/, "") || "/";
          return sheetOrder.indexOf(path);
        }

        function fontsReady() {
          if (!document.fonts || !document.fonts.ready) return Promise.resolve();
          var next = document.documentElement.lang === "ar" ? "ar" : "en";
          return warm(next).then(function () {
            return document.fonts.ready;
          });
        }

        document.addEventListener("astro:before-preparation", function (event) {
          var from = sheetIndex(event.from);
          var to = sheetIndex(event.to);
          var rtl = document.documentElement.dir === "rtl";
          var travel = "rise";
          if (from >= 0 && to >= 0 && from !== to) {
            var towardEnd = to > from;
            if (rtl) towardEnd = !towardEnd;
            travel = towardEnd ? "forward" : "back";
          }
          document.documentElement.setAttribute("data-travel", travel);
          var original = event.loader;
          event.loader = async function () {
            await original();
            await fontsReady();
          };
        });

        document.addEventListener("astro:before-swap", function (event) {
          var next = document.documentElement.lang === "ar" ? "ar" : "en";
          var doc = event.newDocument;
          if (!doc || !doc.documentElement) return;
          doc.documentElement.lang = next;
          doc.documentElement.dir = next === "ar" ? "rtl" : "ltr";
          var travel = document.documentElement.getAttribute("data-travel");
          if (travel) doc.documentElement.setAttribute("data-travel", travel);
          var title = doc.getElementById("doc-title");
          if (title) title.textContent = title.getAttribute("data-" + next) || title.textContent;
          var desc = doc.getElementById("doc-desc");
          if (desc) desc.setAttribute("content", desc.getAttribute("data-" + next) || "");
        });

        document.addEventListener("astro:page-load", function () {
          apply(document.documentElement.lang === "ar" ? "ar" : "en", false);
        });

        apply(lang, false);
      })();
    </script>
  </body>
</html>
